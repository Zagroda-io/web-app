// Job Application_Deployer-Zagroda_WebApp — wdrożenie web-app na PROD (app.zagroda.io).
// PROD działa na VM zagroda-backend, obok Jenkinsa (kontener zagroda-jenkins z gniazdem Dockera hosta), więc job
// nie potrzebuje SSH. DEV (app.dev.zagroda.io) działa na Vercelu i buduje się tam sam — ten job go nie dotyczy.
//
// Wdrażamy wyłącznie wydanie: tag vX.Y.Z, który ma gotowy obraz X.Y.Z w Artifact Registry. Tag i obraz powstają
// po ręcznym uruchomieniu workflow „Budowanie obrazu Docker” na branchu release/**. Job niczego nie buduje.
//
// Etapy: Przygotowanie → Obraz → Różnice → Zatwierdzenie → Wdrożenie → Smoke test.
// Opis całości i konfiguracja: devops/jenkins/README.md.

SUMMARY = []

PROD = [
    container: 'zagroda-web-app',
    alias    : 'web-app',
    apiUrl   : 'https://api.cloud.zagroda.io/api/v1',
    url      : 'https://app.zagroda.io',
]

GIT_CREDENTIALS = ''

def fetchHistory() {
    def fetch = {
        sh '''#!/bin/bash
            set -euo pipefail
            if [ "$(git rev-parse --is-shallow-repository)" = true ]; then git fetch --quiet --unshallow; fi
            git fetch --quiet --prune --prune-tags --tags --force origin '+refs/heads/*:refs/remotes/origin/*'
        '''
    }
    if (GIT_CREDENTIALS) {
        withCredentials([gitUsernamePassword(credentialsId: GIT_CREDENTIALS)]) { fetch() }
    } else {
        fetch()
    }
}

@NonCPS
def marker(String log, String name) {
    def m = log =~ /(?m)^::${name}::(.*)$/
    return m.find() ? m.group(1).trim() : ''
}

@NonCPS
def jsonField(String json, String name) {
    def m = json =~ /"${name}"\s*:\s*"([^"]*)"/
    return m.find() ? m.group(1) : ''
}

def triggeredBy() {
    def causes = currentBuild.getBuildCauses('hudson.model.Cause$UserIdCause')
    return causes ? causes[0].userName : 'automat'
}

pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
        buildDiscarder(logRotator(numToKeepStr: '50'))
        timeout(time: 30, unit: 'MINUTES')
    }

    parameters {
        string(
            name: 'TAG',
            defaultValue: '',
            trim: true,
            description: 'Wydanie do wdrożenia na app.zagroda.io: v1.0.0 albo 1.0.0. Lista wydań: GitHub → web-app → Releases.'
        )
    }

    environment {
        NETWORK = 'zagroda-network'
    }

    stages {
        stage('Przygotowanie') {
            steps {
                checkout scm
                script {
                    if (!(params.TAG ==~ /^v?[0-9]+\.[0-9]+\.[0-9]+$/)) {
                        error "Podaj tag wydania vX.Y.Z (np. v1.0.0), a nie „${params.TAG}”. Wydanie powstaje po ręcznym uruchomieniu workflow „Budowanie obrazu Docker” na branchu release/**."
                    }
                    env.VERSION = params.TAG.startsWith('v') ? params.TAG.substring(1) : params.TAG
                    env.TARGET_TAG = env.VERSION

                    fetchHistory()
                    env.TARGET_SHA = sh(returnStdout: true, script: 'git rev-parse -q --verify "refs/tags/v$VERSION^{commit}" || true').trim()
                    if (!env.TARGET_SHA) {
                        error "Nie ma tagu v${env.VERSION} w repozytorium web-app."
                    }

                    currentBuild.displayName = "#${env.BUILD_NUMBER} v${env.VERSION}"
                    SUMMARY << "web-app:${env.TARGET_TAG} → PROD (${PROD.url.replace('https://', '')}) · ${triggeredBy()}"
                }
            }
        }

        stage('Obraz') {
            steps {
                script {
                    def status = sh(returnStatus: true, script: 'bash devops/jenkins/image.sh exists "$TARGET_TAG"')
                    if (status == 3) {
                        error "Tag v${env.VERSION} nie ma obrazu ${env.TARGET_TAG} w rejestrze. Tag powstaje dopiero po wysłaniu obrazu — sprawdź workflow „Budowanie obrazu Docker” na branchu release/**, z którego wydano v${env.VERSION}."
                    }
                    if (status != 0) {
                        error 'Nie udało się sprawdzić obrazu w Artifact Registry — szczegóły w logu etapu Obraz.'
                    }
                }
            }
        }

        stage('Różnice') {
            steps {
                script {
                    withEnv(["ENV_NAME=PROD", "CONTAINER=${PROD.container}"]) {
                        sh '''#!/bin/bash
                            set -o pipefail
                            bash devops/jenkins/diff.sh 2>&1 | tee roznice.txt
                        '''
                    }
                    def log = readFile('roznice.txt')
                    def current = marker(log, 'current_tag')
                    if (marker(log, 'first') == 'true') {
                        SUMMARY << 'Pierwsze wdrożenie'
                    } else if (marker(log, 'same') == 'true') {
                        SUMMARY << "Ten sam commit co obecnie (${current}) — kontener zostanie odtworzony"
                    } else if (marker(log, 'unknown') == 'true') {
                        SUMMARY << "Obecnie ${current} — bez listy zmian (nieznany commit)"
                    } else {
                        def parts = ["+${marker(log, 'commits')} commitów"]
                        if (marker(log, 'removed') != '0') {
                            parts << "−${marker(log, 'removed')} commitów (cofnięcie)"
                        }
                        SUMMARY << "Obecnie ${current} (${marker(log, 'current_sha')}) → ${env.TARGET_TAG}: ${parts.join(', ')}"
                    }
                }
            }
        }

        stage('Zatwierdzenie') {
            steps {
                timeout(time: 15, unit: 'MINUTES') {
                    input(
                        message: "Wdrożyć web-app ${env.TARGET_TAG} na PROD (${PROD.url})? Różnice są w logu etapu Różnice i w artefakcie roznice.txt.",
                        ok: 'Wdróż'
                    )
                }
            }
        }

        stage('Wdrożenie') {
            steps {
                script {
                    def status = 0
                    withEnv(["CONTAINER=${PROD.container}", "ALIAS=${PROD.alias}", "API_URL=${PROD.apiUrl}"]) {
                        status = sh(returnStatus: true, script: '''#!/bin/bash
                            set -o pipefail
                            bash devops/jenkins/deploy.sh 2>&1 | tee deploy.log
                        ''')
                    }
                    def log = readFile('deploy.log')
                    def previous = marker(log, 'previous')
                    if (status == 0) {
                        SUMMARY << "Wdrożono ${env.TARGET_TAG}${previous ? ' (poprzednio ' + previous + ')' : ''}"
                    } else if (marker(log, 'result') == 'nie-wstala') {
                        SUMMARY << "Nowa wersja nie wstała — ${previous ? 'dalej działa ' + previous : 'web-app nie działa'} (logi w deploy.log)"
                    } else {
                        SUMMARY << "Wdrożenie nie powiodło się (kod ${status}) — szczegóły w deploy.log"
                    }
                    if (status != 0) {
                        error 'Wdrożenie nie powiodło się.'
                    }
                }
            }
        }

        stage('Smoke test') {
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                    script {
                        withEnv(["PUBLIC_URL=${PROD.url}"]) {
                            def health = sh(returnStdout: true, script: 'curl -fsS --max-time 15 --retry 5 --retry-delay 3 --retry-all-errors "$PUBLIC_URL/api/health" 2>/dev/null || true').trim()
                            def runtime = sh(returnStdout: true, script: 'curl -fsS --max-time 15 "$PUBLIC_URL/runtime-config.js" 2>/dev/null || true').trim()
                            def version = jsonField(health, 'version')
                            def commit = jsonField(health, 'commit')
                            SUMMARY << "${PROD.url.replace('https://', '')}: ${health ? 'UP' : 'brak odpowiedzi'}${version ? ', wersja ' + version : ''}"
                            if (!health) {
                                error "${PROD.url}/api/health nie odpowiada"
                            }
                            if (commit != env.TARGET_SHA) {
                                error "${PROD.url}/api/health pokazuje commit „${commit ?: 'brak'}”, oczekiwano ${env.TARGET_SHA} — odpowiada inna wersja niż wdrożona"
                            }
                            if (jsonField(runtime, 'apiUrl') != PROD.apiUrl) {
                                error "${PROD.url}/runtime-config.js nie wskazuje ${PROD.apiUrl}"
                            }
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                currentBuild.description = SUMMARY.join('\n')
            }
            sh(returnStatus: true, script: '''
                for f in roznice.txt deploy.log; do
                    [ -f "$f" ] || continue
                    { printf '\\357\\273\\277'; cat "$f"; } > "$f.utf8" && mv "$f.utf8" "$f"
                done
            ''')
            archiveArtifacts(artifacts: 'roznice.txt, deploy.log', allowEmptyArchive: true, fingerprint: false)
            cleanWs()
        }
    }
}
